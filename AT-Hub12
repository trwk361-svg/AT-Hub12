---------------------------------------------------------
-- التعديل الجديد: نظام مطاردة مباشر ومتحرك بقوة للخصم
---------------------------------------------------------
local isHoldActive = false
local isSpinActive = false
local holdConn = nil
local lastManualInputTime = 0

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.Keyboard then
        lastManualInputTime = tick()
    end
end)

local function isTrueEnemy(p)
    if p == LocalPlayer then return false end
    if p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then return false end
    return true
end

local function getCarriedBomb()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("bomb") or item.Name:lower():find("tnt")) then
            return item
        end
    end
    return nil
end

local function getBombTimer()
    local char = LocalPlayer.Character
    if not char then return 999 end
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") then
            for _, v in pairs(item:GetDescendants()) do
                if (v:IsA("NumberValue") or v:IsA("IntValue")) and (v.Name:lower():find("time") or v.Name:lower():find("timer")) then
                    return v.Value
                end
            end
        end
    end
    return 999
end

HoldToggleBtn.MouseButton1Click:Connect(function()
    isHoldActive = not isHoldActive
    if isHoldActive then
        HoldToggleBtn.Text = "⚡ هولد: شغال"
        HoldToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        HoldToggleBtn.UIStroke.Color = Color3.fromRGB(100, 255, 100)
        
        holdConn = RunService.RenderStepped:Connect(function()
            pcall(function()
                if not isHoldActive then return end
                
                -- إذا تدخل اللاعب يدويًا، نعطيه الحرية
                if tick() - lastManualInputTime < 1.5 then return end
                
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char.HumanoidRootPart
                
                -- زيادة السرعة بقوة ليلحق الخصم
                if hum and hum.Health > 0 then 
                    hum.WalkSpeed = 35 
                end
                
                local bomb = getCarriedBomb()
                if bomb then
                    local bombTimer = getBombTimer()
                    local closestRoot, minDist = nil, math.huge
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if isTrueEnemy(p) and p.Character then
                            local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
                            if eRoot and eHum and eHum.Health > 0 then
                                local dist = (root.Position - eRoot.Position).Magnitude
                                if dist < minDist then
                                    minDist = dist
                                    closestRoot = eRoot
                                end
                            end
                        end
                    end
                    
                    if closestRoot and hum then
                        local targetPos = closestRoot.Position
                        
                        -- استخدام خاصية الـ CFrame مباشرة لتوجيه الشخصية ومطاردة الخصم بدون وقوف
                        root.CFrame = CFrame.new(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
                        
                        local moveDir = (targetPos - root.Position).Unit
                        
                        if bombTimer <= holdTimeValue then
                            moveDir = -moveDir -- الهرب عند انتهاء الوقت
                            bomb:Activate()     -- تسليم القنبلة
                        end
                        
                        hum:Move(moveDir * 2, true)
                    end
                end
            end)
        end)
    else
        HoldToggleBtn.Text = "⚡ هولد: مغلق"
        HoldToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        HoldToggleBtn.UIStroke.Color = Color3.fromRGB(255, 100, 100)
        if holdConn then holdConn:Disconnect(); holdConn = nil end
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
            end
        end)
    end
end)

